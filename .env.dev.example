# Copy to .env.dev. Use the connection string from the development project's
# Supabase dashboard (Connect > direct connection or session pooler).
DEV_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# The project reference of the designated development Supabase project.
DEV_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
